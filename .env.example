# ============================================
# Server
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# Database
# ============================================
MONGODB_URI=mongodb://localhost:27017/wdp_manga

# ============================================
# JWT
# ============================================
JWT_SECRET=change-me-in-production-please

# ============================================
# Frontend URLs (for CORS)
# ============================================
FRONTEND_DEV_URL=http://localhost:5173
FRONTEND_PROD_URL=https://wdp-fe.example.com
BACKEND_URL=https://wdp-be.example.com

# ============================================
# PayOS - Cổng thanh toán
# Docs: https://payos.vn/docs
# ============================================
PAYOS_CLIENT_ID=dc5ae884-69b8-49af-90ea-4b4eb18dd181
PAYOS_API_KEY=4d23de72-fae7-40cf-a08c-5712092936cc
PAYOS_CHECKSUM_KEY=f597334eaba57cd01513cbb8dbd8e6c5ffb3fbcc743a5a642081ae838356b16e
PAYOS_BASE_URL=https://api-merchant.payos.vn
PAYOS_RETURN_URL=http://localhost:5173/payment/return
PAYOS_CANCEL_URL=http://localhost:5173/payment/cancel
# URL HTTPS public mà PayOS gọi khi giao dịch thành công.
# Nếu bỏ trống, hệ thống dùng BACKEND_URL + /payments/payos/webhook
PAYOS_WEBHOOK_URL=https://wdp-be.example.com/payments/payos/webhook
# Khi true: không gọi PayOS thật, dùng mock checkout URL
# Cho phép test nạp Coin mà không cần tài khoản PayOS
PAYOS_MOCK=true
PAYMENT_TIMEOUT_SECONDS=120

# ============================================
# Monetization
# ============================================
# Phần trăm phí nền tảng (mặc định 20 = 20%)
PLATFORM_FEE_PERCENT=20
# CoinUnit scale is fixed in code: 100 CoinUnit = 1 Coin.
# Tỷ giá 1 Coin = bao nhiêu VNĐ (mặc định 100)
COIN_TO_VND_RATE=100
# Số tiền tối thiểu được rút (mặc định 200000 VNĐ)
MIN_WITHDRAWAL_VND=200000

# ============================================
# Revenue pending period
# Trong bao lâu revenue nằm ở "pending" trước khi "available"
# Production: 24
# Dev/test:   0.003 (~10 giây) hoặc 0.0167 (~1 phút)
# ============================================
REVENUE_PENDING_HOURS=0.003

# ============================================
# Email (cho OTP đăng ký)
# ============================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@wdp-manga.com
