#!/usr/bin/env node

var { buildApp, connectAndSeedDatabase } = require('../app');
var debug = require('debug')('wdp-be:server');
var expressApp;
var server;

(async () => {
  try {
    await connectAndSeedDatabase();
    const built = buildApp();
    expressApp = built.app;
    server = built.server;
  } catch (err) {
    console.error('Bootstrap failed:', err.message);
    process.exit(1);
  }

  var { startScheduledPublishJob } = require('../jobs/scheduledPublish');
  var { startAutoCancelJob } = require('../jobs/seriesEndRequestAutoCancel');
  var { startRevenueReleaseJob } = require('../jobs/revenueRelease');
  var port = normalizePort(process.env.PORT || '3000');

  expressApp.set('port', port);

  server.listen(port, function () {
    console.log('Server running on https://wdp-be-a2qb.onrender.com');
    startScheduledPublishJob();
    startAutoCancelJob();
    startRevenueReleaseJob();
  });
  server.on('error', onError);
  server.on('listening', onListening);
  server.on('close', function () {
    var { stopScheduledPublishJob } = require('../jobs/scheduledPublish');
    var { stopAutoCancelJob } = require('../jobs/seriesEndRequestAutoCancel');
    var { stopRevenueReleaseJob } = require('../jobs/revenueRelease');
    stopScheduledPublishJob();
    stopAutoCancelJob();
    stopRevenueReleaseJob();
  });
})();

function normalizePort(val) {
  var port = parseInt(val, 10);
  if (isNaN(port)) return val;
  if (port >= 0) return port;
  return false;
}

function onError(error) {
  if (error.syscall !== 'listen') throw error;
  var bind = typeof port === 'string' ? 'Pipe ' + port : 'Port ' + port;
  switch (error.code) {
    case 'EACCES':
      console.error(bind + ' requires elevated privileges');
      process.exit(1);
      break;
    case 'EADDRINUSE':
      console.error(bind + ' is already in use');
      process.exit(1);
      break;
    default:
      throw error;
  }
}

function onListening() {
  var addr = server.address();
  var bind = typeof addr === 'string' ? 'pipe ' + addr : 'port ' + addr.port;
  debug('Listening on ' + bind);
  console.log('Server running on https://wdp-be-a2qb.onrender.com');
}
